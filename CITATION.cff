    given-names: "Sepehr"
repository-code: "https://github.com/SepehrMohammady/MIND-Edge-Recommender"
keywords:
  - news recommendation
  - multilingual
  - TinyML
  - microcontrollers
  - neural architecture search
  - binarized neural networks
  - knowledge distillation
