# Environments
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# Jupyter
.ipynb_checkpoints/

# Data & large artifacts (downloaded / generated, never committed)
data/
artifacts/
hf_cache/
*.onnx
*.tflite
*.pt
*.pth
*.ckpt

# Logs / scratch
logs/
*.log
.DS_Store

# LaTeX build artifacts (keep .tex/.cls/.bst/.pdf, drop the junk)
*.aux
*.bbl
*.blg
*.out
*.toc
*.synctex.gz
*.fls
*.fdb_latexmk

# board firmware: fetched sources and build outputs (firmware/fetch_deps.py, firmware/nucleo_f401re/build.py)
firmware/third_party/
firmware/*/build/

# model files of the paper (scripts/export_release.py); the checkpoint archive goes to a release, not to git
!models/*.onnx
!models/*.tflite
release/
